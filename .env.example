# Registration API
PORT=3000
FRONTEND_ORIGIN=http://localhost:8001

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Registrations

# Google service account credentials. Never commit real values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional Google Drive folder for uploaded event files
GOOGLE_DRIVE_FOLDER_ID=
MAX_FILE_SIZE_MB=10
